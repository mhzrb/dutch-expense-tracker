# Copy to .env and fill in. Never commit the real .env.

# Generate one at https://djecrety.ir/ or run:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-this-to-a-random-secret-key

DEBUG=True

# SQLite by default — zero config, free, fine for personal use.
# For Postgres (also free via Neon/Supabase/local install), set:
# DATABASE_URL=postgres://user:password@localhost:5432/expensetracker
DATABASE_URL=sqlite:///db.sqlite3
